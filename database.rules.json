{
  "rules": {
    ".read": "auth != null",
    ".write": "auth != null",
    "orders": {
      ".indexOn": ["tableId", "status", "createdAt"]
    },
    "payments": {
      ".indexOn": ["createdAt", "billNumber", "customerId", "orderId", "method"]
    },
    "kitchenPurchases": {
      ".indexOn": ["date", "category"]
    },
    "invMappings": {
      ".indexOn": ["menuItemId", "productId"]
    },
    "customers": {
      ".indexOn": ["phone"]
    },
    "tables": {
      ".indexOn": ["status"]
    }
  }
}