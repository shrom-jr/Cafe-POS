{
  "rules": {
    ".read": true,
    ".write": true,
    "orders": {
      ".indexOn": ["status", "tableId", "createdAt"]
    },
    "payments": {
      ".indexOn": ["createdAt", "customerId", "method"]
    },
    "kitchenPurchases": {
      ".indexOn": ["createdAt", "supplierId"]
    },
    "invMappings": {
      ".indexOn": ["menuItemId", "productId", "inventoryType"]
    },
    "customers": {
      ".indexOn": ["phone", "lastVisit", "currentDue"]
    },
    "tables": {
      ".indexOn": ["status", "area", "orderId"]
    }
  }
}